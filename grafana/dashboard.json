          },
          "refId": "A",
          "queryText": "SELECT timestamp AS time, severity AS \"Sévérité\", category AS \"Catégorie\", resource_name AS \"Ressource\", description AS \"Description\" FROM system_incidents WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 ORDER BY timestamp DESC LIMIT 50",
          "rawQueryText": "SELECT timestamp AS time, severity AS \"Sévérité\", category AS \"Catégorie\", resource_name AS \"Ressource\", description AS \"Description\" FROM system_incidents WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 ORDER BY timestamp DESC LIMIT 50",
