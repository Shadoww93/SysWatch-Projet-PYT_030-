    {
      "id": 9,
      "type": "state-timeline",
      "title": "Disponibilité des services (UP / DOWN)",
      "description": "Une ligne par service : vert = UP, rouge = DOWN.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT timestamp AS time, service_name, is_healthy FROM service_health WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 AND service_name IN (${service:sqlstring}) ORDER BY timestamp",
          "rawQueryText": "SELECT timestamp AS time, service_name, is_healthy FROM service_health WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 AND service_name IN (${service:sqlstring}) ORDER BY timestamp",
          "queryType": "time series",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.service_name}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Temps de réponse des services (TTFB)",
      "description": "Temps jusqu'à la réception des en-têtes HTTP, par service.",
