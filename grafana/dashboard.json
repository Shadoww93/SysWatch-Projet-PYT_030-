{
  "__inputs": [
    {
      "name": "DS_SQLITE",
      "label": "SQLite SysWatch",
      "description": "Base data/syswatch.db",
      "type": "datasource",
      "pluginId": "frser-sqlite-datasource",
      "pluginName": "SQLite"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "frser-sqlite-datasource",
      "name": "SQLite",
      "version": "3.0.0"
    }
  ],
  "title": "SysWatch-API — Supervision système",
  "uid": "syswatch",
  "tags": [
    "syswatch",
    "python",
    "sqlite"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
