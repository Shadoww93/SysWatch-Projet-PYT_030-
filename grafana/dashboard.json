  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "CPU global",
      "description": "Dernière mesure de l'utilisation CPU (%).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT cpu_pct AS cpu FROM host_metrics ORDER BY timestamp DESC LIMIT 1",
          "rawQueryText": "SELECT cpu_pct AS cpu FROM host_metrics ORDER BY timestamp DESC LIMIT 1",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "RAM utilisée",
