        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT ram_pct AS ram FROM host_metrics ORDER BY timestamp DESC LIMIT 1",
          "rawQueryText": "SELECT ram_pct AS ram FROM host_metrics ORDER BY timestamp DESC LIMIT 1",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
