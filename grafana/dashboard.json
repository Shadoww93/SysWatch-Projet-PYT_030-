      "type": "table",
      "title": "Top processus actifs",
      "description": "Dernier relevé : processus surveillés + top 5 CPU et RAM.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 9,
        "w": 13,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT pid AS \"PID\", name AS \"Nom\", status AS \"État\", cpu_pct AS \"CPU %\", rss_mb AS \"RAM Mo\", num_threads AS \"Threads\", open_files AS \"Fichiers ouverts\" FROM process_metrics WHERE timestamp = (SELECT MAX(timestamp) FROM process_metrics) ORDER BY cpu_pct DESC, rss_mb DESC LIMIT 15",
          "rawQueryText": "SELECT pid AS \"PID\", name AS \"Nom\", status AS \"État\", cpu_pct AS \"CPU %\", rss_mb AS \"RAM Mo\", num_threads AS \"Threads\", open_files AS \"Fichiers ouverts\" FROM process_metrics WHERE timestamp = (SELECT MAX(timestamp) FROM process_metrics) ORDER BY cpu_pct DESC, rss_mb DESC LIMIT 15",
