        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Load 1 min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
