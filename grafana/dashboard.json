    {
      "id": 8,
      "type": "timeseries",
      "title": "I/O disque : lecture vs écriture",
      "description": "Débits disque calculés par différence entre deux relevés.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT timestamp AS time, disk_read_mb_s AS \"Lecture Mo/s\", disk_write_mb_s AS \"Écriture Mo/s\" FROM host_metrics WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 ORDER BY timestamp",
          "rawQueryText": "SELECT timestamp AS time, disk_read_mb_s AS \"Lecture Mo/s\", disk_write_mb_s AS \"Écriture Mo/s\" FROM host_metrics WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 ORDER BY timestamp",
          "queryType": "table",
          "timeColumns": [
            "time",
