          "rawQueryText": "SELECT timestamp AS time, service_name, response_time_ms FROM service_health WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 AND service_name IN (${service:sqlstring}) AND response_time_ms IS NOT NULL ORDER BY timestamp",
