    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU & Load average",
      "description": "CPU en % (axe gauche) et charge moyenne sur 1 minute (axe droit).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT timestamp AS time, cpu_pct AS \"CPU %\", load_1m AS \"Load 1 min\" FROM host_metrics WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 ORDER BY timestamp",
          "rawQueryText": "SELECT timestamp AS time, cpu_pct AS \"CPU %\", load_1m AS \"Load 1 min\" FROM host_metrics WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 ORDER BY timestamp",
          "queryType": "table",
          "timeColumns": [
