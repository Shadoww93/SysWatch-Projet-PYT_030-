        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Disque $mountpoint",
      "description": "Occupation de la partition choisie dans la variable $mountpoint. Rouge au-delà du seuil d'incident (85 %).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT usage_pct AS disque FROM disk_partitions WHERE mountpoint = ${mountpoint:sqlstring} ORDER BY timestamp DESC LIMIT 1",
          "rawQueryText": "SELECT usage_pct AS disque FROM disk_partitions WHERE mountpoint = ${mountpoint:sqlstring} ORDER BY timestamp DESC LIMIT 1",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "SLA global",
      "description": "Part des tests de santé réussis sur la période affichée.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT ROUND(100.0 * AVG(is_healthy), 2) AS sla FROM service_health WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 AND service_name IN (${service:sqlstring})",
          "rawQueryText": "SELECT ROUND(100.0 * AVG(is_healthy), 2) AS sla FROM service_health WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000 AND service_name IN (${service:sqlstring})",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "N/A",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Certificat SSL le plus proche",
      "description": "Jours restants avant l'expiration du certificat qui expire le plus tôt (services HTTPS).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT MIN(ssl_days_left) AS jours FROM service_health WHERE timestamp = (SELECT MAX(timestamp) FROM service_health) AND ssl_days_left IS NOT NULL AND service_name IN (${service:sqlstring})",
          "rawQueryText": "SELECT MIN(ssl_days_left) AS jours FROM service_health WHERE timestamp = (SELECT MAX(timestamp) FROM service_health) AND ssl_days_left IS NOT NULL AND service_name IN (${service:sqlstring})",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: jours",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "N/A",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Incidents (période)",
      "description": "Nombre d'incidents enregistrés sur la période affichée.",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "${DS_SQLITE}"
          },
          "refId": "A",
          "queryText": "SELECT COUNT(*) AS incidents FROM system_incidents WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000",
          "rawQueryText": "SELECT COUNT(*) AS incidents FROM system_incidents WHERE timestamp >= $__from / 1000 AND timestamp <= $__to / 1000",
          "queryType": "table",
          "timeColumns": [
            "time",
            "ts"
          ]
