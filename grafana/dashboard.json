      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "${DS_SQLITE}"
        },
        "definition": "SELECT DISTINCT service_name FROM service_health ORDER BY 1",
        "query": "SELECT DISTINCT service_name FROM service_health ORDER BY 1",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "sort": 1,
        "hide": 0
      },
      {
        "name": "mountpoint",
        "label": "Point de montage",
        "type": "query",
        "datasource": {
          "type": "frser-sqlite-datasource",
          "uid": "${DS_SQLITE}"
        },
        "definition": "SELECT DISTINCT mountpoint FROM disk_partitions ORDER BY 1",
        "query": "SELECT DISTINCT mountpoint FROM disk_partitions ORDER BY 1",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
