    {
      "id": 12,
      "type": "table",
      "title": "Derniers incidents",
      "description": "Dépassements de seuils enregistrés (période affichée).",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "${DS_SQLITE}"
      },
      "gridPos": {
        "h": 9,
        "w": 11,
        "x": 13,
        "y": 22
